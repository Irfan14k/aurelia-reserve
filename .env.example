# AURELIA RESERVE — environment template
# Copy to `.env` for local development:  cp .env.example .env
#
# On Vercel: Project → Settings → Environment Variables (Production, Preview
# and Development), then redeploy. Both values are safe to expose to the
# browser — the anon key is publishable and access is enforced by Row Level
# Security (supabase/migrations/). Never put the service_role key here.
#
# Leave both empty and the site still builds and runs: residences fall back to
# src/data/residences.js, enquiries simulate, and the members portal shows a
# configuration notice.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
